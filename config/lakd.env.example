# ── LAKd configuration example ─────────────────────────────────────
# Copy to lakd.env and source it before starting the daemon, or pass
# the variables through your service manager / container runtime.

# gRPC bind address
LAK_LISTEN_ADDR=0.0.0.0:9191

# Maximum number of concurrent agents
LAK_MAX_AGENTS=1000

# ── LLM backends (all optional; omit to run without cloud LLMs) ────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Local Ollama instance
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Set to 1 to disable cloud drivers even when API keys are present
# (useful for air-gapped / privacy-sensitive deployments)
# LAK_DISABLE_CLOUD_LLM=1

# ── Logging ─────────────────────────────────────────────────────────
RUST_LOG=lak=debug,tonic=info
